# 会话签名密钥，生产环境必填（任意长随机字符串）
SECRET_KEY=

# 管理员账号，首次启动时创建
ADMIN_USERNAME=SoaringBird
ADMIN_PASSWORD=

# 邮件发送（可选，留空则跳过邮件相关功能）
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
RESEND_FROM_NAME=SoaringBird

# 人机验证（可选，留空则不启用）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI 助手（可选，任意 OpenAI 兼容接口）
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=local-model
AI_API_KEY=

# 内容翻译（可选）
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# 运行数据目录，默认当前目录
DATA_DIR=

# 第三方登录（可选，留空则不显示该入口）
HS_OAUTH_BASE=
HS_OAUTH_APP_ID=
HS_OAUTH_APP_SECRET=
HS_OAUTH_REDIRECT_URI=

# 团队空间令牌签名密钥（可选，留空则由 SECRET_KEY 派生）
TEAM_SECRET=
